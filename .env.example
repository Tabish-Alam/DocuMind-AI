# Document Intelligence + RAG Configuration
# Copy this file to .env and fill in your values

# Groq API Key - Get your free key at https://console.groq.com/keys
# If you skip this, the app will expect the key via X-Groq-Api-Key header per-request
GROQ_API_KEY=gsk_your_api_key_here

# Server Configuration
# SERVER_PORT=8000
# DEBUG=false

# (Optional) Embedding Model - Keep default for best balance of speed/quality
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# (Optional) LLM Model - Default is mixtral-8x7b-32768
# Available Groq models: mixtral-8x7b-32768, llama-3.1-70b-versatile, llama-3.1-8b-instant
# LLM_MODEL=mixtral-8x7b-32768

# (Optional) Vector Store Configuration
# MAX_STORED_DOCUMENTS=1000
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# (Optional) Logging
# LOG_LEVEL=INFO
